l-gradient(circle at 92% 4%, rgba(42, 103, 214, 0.18), transparent 26%),\\n    radial-gradient(circle at 50% 100%, rgba(16, 185, 129, 0.08), transparent 28%),\\n    linear-gradient(180deg, var(--bg-page) 0%, #f3f1ee 30%, var(--bg-page-deep) 100%);\\n}\\n\\nh1,\\nh2,\\nh3,\\nh4 {\\n  text-wrap: balance;\\n}\\n\\n* {\\n  box-sizing: border-box;\\n}\\n\\n.skip-link {\\n  position: absolute;\\n  left: 16px;\\n  top: 16px;\\n  z-index: 20;\\n  padding: 10px 14px;\\n  border-radius: 999px;\\n  background: #0f172a;\\n  color: #eff6ff;\\n  transform: translateY(-140%);\\n  transition: transform 160ms ease;\\n}\\n\\n.skip-link:focus-visible {\\n  transform: translateY(0);\\n}\\n\\n.app-layout {\\n  position: relative;\\n  isolation: isolate;\\n  width: 100%;\\n  height: 100%;\\n  background: transparent;\\n}\\n\\n.app-layout::before {\\n  content: \\\"\\\";\\n  position: fixed;\\n  inset: 0;\\n  background:\\n    linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),\\n    linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px);\\n  background-size: 40px 40px;\\n  mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.18), transparent 80%);\\n  pointer-events: none;\\n  z-index: -1;\\n}\\n\\n.app-header {\\n  position: sticky;\\n  top: 0;\\n  z-index: 10;\\n  background: rgba(251, 247, 241, 0.74);\\n  backdrop-filter: blur(22px);\\n  padding: 18px 24px;\\n  height: auto;\\n  line-height: 1.4;\\n  border-bottom: 1px solid rgba(17, 35, 59, 0.06);\\n  box-shadow: 0 8px 28px rgba(17, 35, 59, 0.05);\\n}\\n\\n.header-bar {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-end;\\n  gap: 24px;\\n}\\n\\n.header-title-group {\\n  min-width: 0;\\n  max-width: 940px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.header-brand-row {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  flex-wrap: wrap;\\n}\\n\\n.brand-chip {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  width: 34px;\\n  height: 34px;\\n  border-radius: 50%;\\n  background: linear-gradient(135deg, #143056, #234f84);\\n  color: #fff5e6;\\n  font-size: 12px;\\n  font-weight: 700;\\n  letter-spacing: 0.08em;\\n  box-shadow: 0 10px 24px rgba(17, 35, 59, 0.18);\\n}\\n\\n.header-title {\\n  font-family: var(--font-display);\\n  letter-spacing: 0.01em;\\n  font-size: clamp(1.9rem, 1.55rem + 0.85vw, 2.5rem) !important;\\n  color: #16243b !important;\\n}\\n\\n.header-subtitle {\\n  margin: 0 !important;\\n  color: var(--text-muted) !important;\\n  font-size: 14px;\\n  line-height: 1.75;\\n  max-width: 760px;\\n}\\n\\n.header-state-pill {\\n  margin-inline-end: 0 !important;\\n  padding-inline: 12px !important;\\n}\\n\\n.header-actions {\\n  display: flex;\\n  justify-content: flex-end;\\n  align-items: center;\\n  gap: 16px;\\n  flex-wrap: wrap;\\n}\\n\\n.header-status-grid {\\n  gap: 8px;\\n}\\n\\n.header-status-grid .ant-tag {\\n  margin-inline-end: 0;\\n  padding-inline: 11px;\\n  padding-block: 5px;\\n  border-radius: 999px;\\n  border-color: rgba(255, 255, 255, 0.72);\\n  background: rgba(255, 255, 255, 0.68);\\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.52);\\n}\\n\\n.section-kicker {\\n  color: rgba(31, 57, 92, 0.72);\\n  font-size: 11px;\\n  font-weight: 700;\\n  letter-spacing: 0.14em;\\n  text-transform: uppercase;\\n}\\n\\n.section-subtitle {\\n  color: var(--text-muted);\\n  font-size: 13px;\\n  line-height: 1.68;\\n}\\n\\n.session-switcher {\\n  gap: 10px !important;\\n}\\n\\n.session-picker-btn,\\n.session-new-btn {\\n  min-height: 42px;\\n  padding-inline: 18px !important;\\n  box-shadow: none !important;\\n}\\n\\n.session-picker-btn {\\n  border-color: rgba(17, 35, 59, 0.1) !important;\\n  background: rgba(255, 255, 255, 0.72) !important;\\n}\\n\\n.session-new-btn {\\n  background: linear-gradient(135deg, #1d4ed8, #2563eb) !important;\\n  border-color: transparent !important;\\n}\\n\\n.app-body {\\n  min-height: 0;\\n  gap: 18px;\\n  padding: 18px 20px 20px;\\n}\\n\\n.center-pane {\\n  min-width: 0;\\n  min-height: 0;\\n  padding: 0;\\n  display: flex;\\n}\\n\\n.center-pane-main {\\n  display: flex;\\n  min-width: 0;\\n  width: 100%;\\n}\\n\\n.workspace-stack {\\n  display: flex;\\n  flex-direction: column;\\n  width: 100%;\\n  min-height: 0;\\n  gap: 14px;\\n}\\n\\n.workspace-alert-stack {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\\n  gap: 12px;\\n}\\n\\n.workspace-alert {\\n  border-radius: 22px !important;\\n  border: 1px solid rgba(125, 161, 255, 0.2) !important;\\n  background: rgba(239, 246, 255, 0.84) !important;\\n  box-shadow: var(--shadow-md);\\n}\\n\\n.workspace-alert-warning {\\n  background: rgba(255, 251, 235, 0.92) !important;\\n}\\n\\n.chat-card {\\n  width: 100%;\\n  min-height: 0;\\n  display: flex;\\n  border-radius: 30px !important;\\n  border: 1px solid rgba(255, 255, 255, 0.78) !important;\\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(251, 252, 255, 0.8)) !important;\\n  backdrop-filter: blur(18px);\\n  box-shadow: var(--shadow-xl);\\n}\\n\\n.chat-card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  gap: 12px;\\n  padding-bottom: 14px;\\n  border-bottom: 1px solid var(--line-soft);\\n}\\n\\n.chat-card-caption {\\n  white-space: nowrap;\\n  color: var(--text-muted);\\n  font-size: 12px;\\n}\\n\\n.right-sider {\\n  background: transparent !important;\\n}\\n\\n.snapshot-shell {\\n  display: flex;\\n  flex-direction: column;\\n  height: 100%;\\n  border-radius: 30px;\\n  border: 1px solid rgba(255, 255, 255, 0.74);\\n  background: rgba(250, 251, 255, 0.72);\\n  backdrop-filter: blur(18px);\\n  box-shadow: var(--shadow-lg);\\n}\\n\\n.snapshot-shell-header {\\n  padding: 18px 20px 14px;\\n  border-bottom: 1px solid var(--line-soft);\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n}\\n\\n.panel-scroll {\\n  flex: 1;\\n  overflow: auto;\\n  padding: 16px 18px 20px;\\n}\\n\\n.panel-scroll::-webkit-scrollbar,\\n.chat-thread::-webkit-scrollbar {\\n  width: 10px;\\n}\\n\\n.panel-scroll::-webkit-scrollbar-thumb,\\n.chat-thread::-webkit-scrollbar-thumb {\\n  background: rgba(17, 35, 59, 0.12);\\n  border-radius: 999px;\\n}\\n\\n.chat-thread {\\n  flex: 1;\\n  min-height: 0;\\n  overflow: auto;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n  padding-right: 2px;\\n}\\n\\n.assistant-turn {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.message-meta {\\n  gap: 6px !important;\\n}\\n\\n.composer-wrap {\\n  margin-top: auto;\\n  border-top: 1px solid var(--line-soft);\\n  padding-top: 16px;\\n}\\n\\n.composer-headline {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n  margin-bottom: 10px;\\n}\\n\\n.composer-wrap .ant-input,\\n.composer-wrap .ant-input-textarea {\\n  border-radius: 22px 0 0 22px !important;\\n  background: rgba(255, 255, 255, 0.96);\\n}\\n\\n.composer-wrap .ant-btn {\\n  border-radius: 0 22px 22px 0 !important;\\n  min-width: 112px;\\n}\\n\\n.bubble {\\n  border-radius: 24px;\\n}\\n\\n.bubble-user {\\n  margin-left: 64px;\\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(247, 249, 254, 0.93));\\n  border: 1px solid rgba(17, 35, 59, 0.06);\\n  box-shadow: 0 8px 24px rgba(17, 35, 59, 0.04);\\n}\\n\\n.main-conclusion-card {\\n  overflow: hidden;\\n  border: 0 !important;\\n  border-radius: 28px !important;\\n  background:\\n    radial-gradient(circle at top right, rgba(56, 189, 248, 0.24), transparent 32%),\\n    radial-gradient(circle at left top, rgba(251, 191, 36, 0.2), transparent 26%),\\n    linear-gradient(148deg, #0f223d 0%, #13325a 46%, #17507a 100%) !important;\\n  color: #eff6ff;\\n  box-shadow: var(--shadow-xl);\\n}\\n\\n.main-conclusion-card .ant-card-body {\\n  position: relative;\\n}\\n\\n.main-conclusion-card .ant-typography {\\n  color: #eff6ff;\\n}\\n\\n.main-conclusion-hero {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  gap: 20px;\\n}\\n\\n.main-conclusion-copy {\\n  max-width: 720px;\\n}\\n\\n.hero-kicker {\\n  color: rgba(255, 246, 232, 0.72);\\n  font-size: 11px;\\n  font-weight: 700;\\n  letter-spacing: 0.16em;\\n  text-transform: uppercase;\\n}\\n\\n.hero-copy {\\n  margin: 12px 0 0 !important;\\n  color: rgba(239, 246, 255, 0.84) !important;\\n  font-size: 15px;\\n  line-height: 1.88;\\n}\\n\\n.hero-status {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: flex-end;\\n  gap: 10px;\\n}\\n\\n.hero-status .ant-tag {\\n  margin-inline-end: 0;\\n}\\n\\n.hero-timestamp {\\n  color: rgba(239, 246, 255, 0.68);\\n  font-size: 12px;\\n}\\n\\n.main-conclusion-metrics {\\n  gap: 12px !important;\\n}\\n\\n.main-conclusion-card .mini-block {\\n  min-width: 220px;\\n  max-width: 320px;\\n  background: rgba(255, 255, 255, 0.08);\\n  border: 1px solid rgba(191, 219, 254, 0.16);\\n  padding: 14px 16px;\\n  border-radius: 18px;\\n  backdrop-filter: blur(10px);\\n}\\n\\n.recommendation-pick-card,\\n.recommendation-message-card,\\n.detail-card,\\n.snapshot-card,\\n.ops-subcard,\\n.narrative-card {\\n  border-radius: 20px !important;\\n  border: 1px solid var(--line-soft) !important;\\n  background: var(--bg-surface-strong) !important;\\n  box-shadow: var(--shadow-md);\\n}\\n\\n.snapshot-overview-card {\\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 250, 255, 0.94)) !important;\\n}\\n\\n.snapshot-summary {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n}\\n\\n.followup-text-card {\\n  border-radius: 18px !important;\\n  border: 1px solid var(--line-soft) !important;\\n  background: rgba(255, 255, 255, 0.9) !important;\\n}\\n\\n.message-card-header,\\n.pick-card-topline {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  gap: 12px;\\n}\\n\\n.rank-dot {\\n  width: 30px;\\n  height: 30px;\\n  border-radius: 50%;\\n  background: linear-gradient(135deg, #10223c, #2857c5);\\n  color: #eff6ff;\\n  display: grid;\\n  place-items: center;\\n  font-size: 12px;\\n  font-weight: 700;\\n}\\n\\n.micro-copy {\\n  color: var(--text-muted);\\n  font-size: 12px;\\n  margin-top: 2px;\\n}\\n\\n.fact-strip {\\n  display: flex;\\n  gap: 8px;\\n  flex-wrap: wrap;\\n}\\n\\n.fact-strip .ant-tag,\\n.snapshot-row .ant-tag {\\n  margin-inline-end: 0;\\n}\\n\\n.pick-grid .ant-descriptions-item-label {\\n  width: 112px;\\n}\\n\\n.ops-card .ant-card-head-title {\\n  font-weight: 700;\\n}\\n\\n.ops-card-topline {\\n  padding: 2px 0 0;\\n}\\n\\n.ops-tool-list .ant-list-item {\\n  padding-inline: 0;\\n}\\n\\n.ops-action-bar .ant-btn {\\n  border-radius: 999px;\\n  min-width: 114px;\\n}\\n\\n.ops-tool-row {\\n  width: 100%;\\n}\\n\\n.tool-service-note {\\n  font-size: 12px;\\n  word-break: break-all;\\n  font-family: var(--font-mono);\\n}\\n\\n.snapshot-row {\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 12px;\\n  align-items: flex-start;\\n  padding: 10px 0;\\n}\\n\\n.snapshot-row + .snapshot-row {\\n  border-top: 1px solid rgba(17, 35, 59, 0.06);\\n}\\n\\n.full-center {\\n  width: 100%;\\n  height: 100vh;\\n  display: grid;\\n  place-items: center;\\n}\\n\\n.empty-state-card {\\n  border: 1px dashed rgba(40, 87, 197, 0.2) !important;\\n  background:\\n    radial-gradient(circle at top center, rgba(255, 214, 153, 0.16), transparent 38%),\\n    rgba(255, 255, 255, 0.72) !important;\\n  box-shadow: none !important;\\n}\\n\\n.empty-state-card .ant-card-body {\\n  min-height: 230px;\\n  display: flex;\\n  align-items: center;\\n}\\n\\n.prompt-chip {\\n  border: 1px solid rgba(191, 219, 254, 0.52) !important;\\n  border-radius: 999px !important;\\n  background: rgba(255, 255, 255, 0.94) !important;\\n  box-shadow: none !important;\\n  color: #1f3554 !important;\\n}\\n\\n.prompt-chip:hover,\\n.prompt-chip:focus-visible {\\n  color: #0f172a !important;\\n  border-color: rgba(96, 165, 250, 0.82) !important;\\n  background: #eff6ff !important;\\n}\\n\\n.json-inline {\\n  font-family: var(--font-mono);\\n  font-size: 12px;\\n  white-space: pre-wrap;\\n  margin: 0;\\n}\\n\\n.json-block {\\n  font-family: var(--font-mono);\\n  font-size: 12px;\\n  white-space: pre-wrap;\\n  background: rgba(17, 35, 59, 0.04);\\n  border: 1px solid rgba(17, 35, 59, 0.08);\\n  border-radius: 14px;\\n  padding: 12px;\\n}\\n\\n@media (max-width: 1320px) {\\n  .app-body {\\n    gap: 14px;\\n    padding: 14px;\\n  }\\n\\n  .hero-status {\\n    align-items: flex-start;\\n  }\\n}\\n\\n@media (max-width: 1200px) {\\n  body {\\n    overflow: auto;\\n  }\\n\\n  .app-body {\\n    flex-direction: column !important;\\n  }\\n\\n  .right-sider {\\n    width: 100% !important;\\n    min-width: 100% !important;\\n    max-width: 100% !important;\\n    flex: 0 0 auto !important;\\n  }\\n\\n  .snapshot-shell {\\n    min-height: 420px;\\n  }\\n\\n  .panel-scroll {\\n    max-height: none;\\n  }\\n\\n  .center-pane {\\n    min-height: auto;\\n    height: auto;\\n    display: block;\\n  }\\n\\n  .center-pane-main,\\n  .workspace-stack {\\n    min-height: auto;\\n    height: auto;\\n  }\\n\\n  .chat-card {\\n    min-height: auto !important;\\n    height: auto !important;\\n    display: block;\\n  }\\n\\n  .chat-card .ant-card-body {\\n    min-height: auto !important;\\n    height: auto !important;\\n    display: block !important;\\n  }\\n\\n  .chat-thread {\\n    flex: none;\\n    overflow: visible;\\n    height: auto;\\n  }\\n\\n  .composer-wrap {\\n    margin-top: 0;\\n  }\\n\\n  .bubble-user {\\n    margin-left: 0;\\n  }\\n\\n  .snapshot-row,\\n  .main-conclusion-hero,\\n  .chat-card-header,\\n  .header-bar,\\n  .message-card-header,\\n  .pick-card-topline {\\n    flex-direction: column;\\n  }\\n\\n  .header-actions {\\n    justify-content: flex-start;\\n  }\\n}\\n\\n@media (max-width: 720px) {\\n  body {\\n    overflow: auto;\\n  }\\n\\n  .app-header {\\n    padding: 14px;\\n  }\\n\\n  .app-body {\\n    padding: 12px;\\n  }\\n\\n  .app-layout,\\n  .app-body,\\n  .center-pane,\\n  .center-pane-main,\\n  .workspace-stack,\\n  .right-sider,\\n  .snapshot-shell {\\n    width: 100% !important;\\n    min-width: 0 !important;\\n    max-width: 100% !important;\\n  }\\n\\n  .center-pane-main {\\n    display: block;\\n  }\\n\\n  .chat-card,\\n  .snapshot-shell {\\n    border-radius: 24px !important;\\n  }\\n\\n  .chat-card .ant-card-body {\\n    min-height: auto !important;\\n  }\\n\\n  .chat-card-header,\\n  .snapshot-shell-header,\\n  .panel-scroll {\\n    padding-left: 0;\\n    padding-right: 0;\\n  }\\n\\n  .workspace-alert-stack {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .workspace-alert .ant-alert-content {\\n    min-width: 0;\\n  }\\n\\n  .workspace-alert .ant-alert-message,\\n  .workspace-alert .ant-alert-description {\\n    word-break: break-word;\\n  }\\n\\n  .header-title-group,\\n  .header-actions,\\n  .header-status-grid,\\n  .session-switcher {\\n    width: 100%;\\n  }\\n\\n  .session-switcher {\\n    flex-direction: column;\\n    align-items: stretch;\\n  }\\n\\n  .session-picker-btn,\\n  .session-new-btn {\\n    width: 100%;\\n  }\\n\\n  .chat-card-caption {\\n    white-space: normal;\\n  }\\n\\n  .panel-scroll {\\n    padding: 16px 0 12px;\\n  }\\n\\n  .main-conclusion-card .mini-block {\\n    min-width: 100%;\\n  }\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
