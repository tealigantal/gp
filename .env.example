##############################################
# .env.example（严格工具 + 双服务：gp 后端 + web 前端）
##############################################

# 时区
TZ=Asia/Shanghai

# 构建用 pip 源（可选）
PIP_INDEX_URL=https://pypi.org/simple

# 运行模式
GP_RUN_MODE=prod
GP_DEV_MODE=0

GP_RESTRICT_MAINLINE=0

# LLM（严格工具，直连 DeepSeek beta）
# 说明：gp 直接调用上游兼容接口
LLM_BASE_URL=https://api.deepseek.com/beta
LLM_API_KEY=
CHAT_MODEL=deepseek-chat
