##############################################
# .env.example（严格工具 + 单一路径）
##############################################

# 时区
TZ=Asia/Shanghai

# 构建用 pip 源（可选）
PIP_INDEX_URL=https://pypi.org/simple

# 运行模式
GP_RUN_MODE=prod
GP_DEV_MODE=0

# LLM（严格工具，经本地 llm-proxy beta）
LLM_BASE_URL=http://llm-proxy:8080/beta
LLM_API_KEY=
CHAT_MODEL=deepseek-chat

# llm-proxy 上游（DeepSeek beta 严格工具）
UPSTREAM_BASE_URL=https://api.deepseek.com/beta
UPSTREAM_API_KEY=
PROXY_REQUIRE_AUTH=false
PROXY_CLIENT_TOKENS=

