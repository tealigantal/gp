##############################################
# .env.example (gp backend + web frontend)
##############################################

# timezone
TZ=Asia/Shanghai

# build registries / indexes
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmmirror.com

# docker build/runtime proxy via host Clash
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
ALL_PROXY=http://host.docker.internal:7890

# runtime mode
GP_RUN_MODE=prod
GP_BACKEND_IMAGE=gp-backend
GP_BACKEND_TAG=local
GP_BUILD_REVISION=local
GP_DEV_MODE=0
GP_RESTRICT_MAINLINE=0
GP_INTRADAY_RUNTIME_ENABLED=1
# Docker Desktop bind mounts should use DELETE; native installs may use WAL.
GP_HISTORY_SQLITE_JOURNAL_MODE=DELETE
GP_HISTORY_SQLITE_FILENAME=history-clean.db

# llm
LLM_BASE_URL=https://api.deepseek.com/beta
LLM_API_KEY=
CHAT_MODEL=deepseek-chat
AGENT_MODEL=deepseek-chat

# Serenity Alpha (free official-announcement experiment)
GP_SERENITY_MODE=native
GP_SERENITY_MAX_WEIGHT=0.08
GP_SERENITY_UPDATE_MATURE_DAYS=5
GP_SERENITY_EVAL_WINDOW_DAYS=60
GP_SERENITY_BOOTSTRAP_LOOKBACK_DAYS=30
GP_SERENITY_EVIDENCE_TTL_DAYS=10
GP_SERENITY_REQUEST_TIMEOUT_SEC=15
GP_SERENITY_PAGE_SIZE=30
GP_SERENITY_PAGE_BUDGET=10
GP_SERENITY_PDF_MAX_BYTES=15728640
GP_SERENITY_REQUEST_SPACING_SEC=1
GP_SERENITY_CONTENT_REVALIDATE_HOURS=6
GP_SERENITY_TARGET_FALLBACK_TTL_SEC=3600
