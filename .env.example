##############################################
# .env.example (gp backend + web frontend)
##############################################

# timezone
TZ=Asia/Shanghai

# build registries / indexes
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmmirror.com

# Optional build proxy. Leave unset for direct access. If a local proxy is
# required, use the address/port currently reachable from Docker Desktop, e.g.
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# ALL_PROXY=http://host.docker.internal:7897

# runtime mode
GP_RUN_MODE=prod
GP_BACKEND_IMAGE=gp-backend
GP_BACKEND_TAG=local
GP_BUILD_REVISION=local
GP_DEV_MODE=0
GP_RESTRICT_MAINLINE=1
GP_INTRADAY_RUNTIME_ENABLED=1
# Resident official-announcement Alpha service. Native mode is required by the
# production selection contract; `off` stops new recommendation publication.
GP_SERENITY_MODE=native
CHAT_MODEL=deepseek-v4-flash
# Docker Desktop bind mounts should use DELETE; native installs may use WAL.
GP_HISTORY_SQLITE_JOURNAL_MODE=DELETE

# Single product database. Do not configure an alternate history filename.
GP_AGENT_DB=/app/store/agent.db
