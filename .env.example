##############################################
# .env.example (gp backend + web frontend)
##############################################

# timezone
TZ=Asia/Shanghai

# build registries / indexes
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmmirror.com

# docker build/runtime proxy via host Clash
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
ALL_PROXY=http://host.docker.internal:7890

# runtime mode
GP_RUN_MODE=prod
GP_DEV_MODE=0
GP_RESTRICT_MAINLINE=0

# llm
LLM_BASE_URL=https://api.deepseek.com/beta
LLM_API_KEY=
CHAT_MODEL=deepseek-chat
